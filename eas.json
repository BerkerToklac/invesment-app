{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "sdk-54"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "sdk-54"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "image": "sdk-54"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
